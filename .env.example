# Copy to .env and replace both passwords before starting.
DATABASE_PASSWORD=replace-with-a-long-random-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
APP_PORT=8080
PROCESSING_LOCK_TIMEOUT_SECONDS=600

# local = deterministic vectors for development; openai = production embedding API.
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CONNECT_TIMEOUT_SECONDS=10
EMBEDDING_READ_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible text generation and browser speech-to-text.
# Leave OPENAI_API_KEY blank to keep these capabilities disabled.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=120
OPENAI_MAX_AUDIO_BYTES=10485760

# Quartz e-qanun trigger: every day at 03:00 in Baku.
EQANUN_SYNC_ENABLED=true
EQANUN_SYNC_CRON=0 0 3 * * ?
EQANUN_SYNC_TIME_ZONE=Asia/Baku
